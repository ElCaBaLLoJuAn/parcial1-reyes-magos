APP_NAME="API Caravanas Reyes Magos"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8001
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES
APP_MAINTENANCE_DRIVER=file
APP_TIMEZONE=America/Guayaquil

BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# --- Seguridad (JWT HS256) ---
# Genera el secreto con: php artisan jwt:secret   (NUNCA lo subas al repositorio)
JWT_SECRET=
JWT_TTL_MINUTOS=120

# --- Servicio SOAP EstrellaDeBelenService ---
# Mock local: php -S 127.0.0.1:8088 mock-soap/server.php   (o la URL del mock del docente)
ESTRELLA_SOAP_URL=http://127.0.0.1:8088/estrella
ESTRELLA_SOAP_TIMEOUT=3
ESTRELLA_SOAP_INTENTOS=2
ESTRELLA_SOAP_BACKOFF_MS=300

# --- Usuarios de prueba que crea el seeder (solo para desarrollo) ---
DEMO_JEFE_CLAVE=Caravana2026!
DEMO_PAJE_CLAVE=Paje2026!
